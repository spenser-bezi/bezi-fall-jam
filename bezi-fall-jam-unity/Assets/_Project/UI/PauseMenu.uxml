<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Theme.uss" />
    <ui:VisualElement name="pause-overlay" class="overlay hidden">
        <ui:VisualElement class="panel" style="align-items: center;">
            <ui:Label text="Paused" class="title" style="font-size: 48px;" />
            <ui:Button name="resume-button" text="Resume" class="button" />
            <ui:Button name="menu-button" text="Main Menu" class="button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
